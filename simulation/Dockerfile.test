FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --disable-pip-version-check --no-cache-dir -r requirements.txt
# Fail at image-build time if MySQL 8.4 SHA-2 account authentication is
# unsupported. The dependency is needed when a new account has no auth cache.
RUN python -c "import pymysql; import cryptography; from cryptography.hazmat.primitives.asymmetric import padding"

COPY runtime/ runtime/
COPY ops/setup_local.py ops/setup_local.py
COPY ops/local_bootstrap_probe.py ops/local_bootstrap_probe.py
COPY tests/ tests/
# Contract tests verify the same Dockerfile used for this image build.
COPY Dockerfile.test Dockerfile.test
COPY schema/001_source.sql schema/001_source.sql
RUN useradd --create-home --uid 10001 testuser && chown -R testuser:testuser /app
USER testuser
CMD ["python","-m","unittest","discover","-s","tests","-v"]
