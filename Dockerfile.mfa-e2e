# Isolated MFA E2E: real Fastify + disposable PostgreSQL + virtual Chromium passkeys.
# Copy only reviewed source paths, never .env, Git metadata or private archives.
FROM node:24-slim
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl git curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend --no-audit --no-fund
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium
COPY prisma.config.ts tsconfig.json ./
COPY prisma ./prisma
COPY src ./src
COPY frontend ./frontend
COPY public ./public
COPY scripts ./scripts
RUN npm run build \
  && mkdir -p /app/test-results \
  && chown -R node:node /app /ms-playwright
USER node
CMD ["sh","-ec","npx prisma db push && node scripts/admin-mfa-live-http-e2e.mjs"]
