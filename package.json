{
  "name": "empower-fin-dashboard-portal",
  "version": "0.10.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc && npm run frontend:build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "check:contract": "tsx tests/contract-check.ts",
    "check:ui": "node scripts/ui-regression-check.mjs",
    "check:admin-ui": "node scripts/admin-ui-check.mjs && node scripts/admin-inline-syntax-check.mjs && npm run check:admin-realtime && npm run check:admin-report-selector",
    "db:deploy": "node scripts/deploy-db.mjs",
    "db:reset:prelive": "prisma db push --force-reset --skip-generate",
    "check:imports": "node scripts/import-regression-check.mjs",
    "check:scheduling": "node scripts/scheduling-regression-check.mjs",
    "db:rebuild-scores": "tsx scripts/rebuild-score-snapshots.ts",
    "security:audit": "npm audit --audit-level=high",
    "check:security": "node scripts/security-regression-check.mjs",
    "sync:configure": "node scripts/configure-mysql-sync.mjs",
    "check:production": "node scripts/production-readiness-check.mjs",
    "check:brand": "node tests/brand-engine.test.mjs",
    "test:score": "node scripts/run-score-test.mjs",
    "check:all": "npm run check:neon-egress && npm run check:source-sync-safety && npm run check:semantic-planner && npm run check:semantic-storage && npm run check:source-vault && npm run check:source-continuity && npm run check:source-reconciliation && npm run check:react && npm run check:role-perspective && npm run check:daily-refresh && npm run check:enterprise-operations && npm run check:admin-realtime && npm run check:admin-report-selector && npm run check:unified-data-ingestion && npm run check:enterprise-analytics-phase-2 && npm run build && npm run check:production && npm run check:security && npm run check:ui && npm run check:imports && npm run check:scheduling && npm run check:security-identity && npm run check:security-operations && npm run check:security-governance && npm run check:south-africa-compliance && npm run check:enterprise && npm run test:score && npm audit --audit-level=high",
    "check:accessibility": "node scripts/accessibility-regression-check.mjs",
    "check:performance": "node scripts/performance-regression-check.mjs",
    "check:enterprise": "npm run check:period-comparison && npm run check:accessibility && npm run check:performance && npm run check:brand && npm run check:mlops && npm run check:mlops-data-quality",
    "check:period-comparison": "node scripts/period-comparison-regression-check.mjs",
    "check:security-identity": "node scripts/security-identity-regression-check.mjs",
    "check:security-operations": "node scripts/security-operations-regression-check.mjs",
    "check:security-full": "npm run build && npm run check:security && npm run check:security-identity && npm run check:security-operations && npm audit --audit-level=high",
    "check:security-governance": "node scripts/security-governance-regression-check.mjs",
    "check:south-africa-compliance": "node scripts/south-africa-compliance-regression-check.mjs",
    "check:enterprise-operations": "node scripts/enterprise-operations-regression-check.mjs",
    "check:enterprise-analytics-phase-2": "node scripts/enterprise-analytics-phase-2-regression-check.mjs",
    "check:unified-data-ingestion": "node scripts/unified-data-ingestion-regression-check.mjs",
    "check:admin-report-selector": "node scripts/admin-report-selector-regression-check.mjs",
    "check:admin-realtime": "node scripts/admin-realtime-regression-check.mjs",
    "check:mlops": "node scripts/mlops-regression-check.mjs",
    "check:mlops-data-quality": "node scripts/mlops-data-quality-regression-check.mjs",
    "check:role-perspective": "node scripts/role-perspective-regression-check.mjs",
    "frontend:build": "npm install --prefix frontend --no-audit --no-fund && npm run build --prefix frontend",
    "check:react": "npm run check:frontend:typecheck && node scripts/react-migration-regression-check.mjs",
    "check:frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "check:daily-refresh": "node scripts/daily-refresh-regression-check.mjs",
    "check:neon-egress": "node scripts/neon-egress-regression-check.mjs",
    "check:source-sync-safety": "node scripts/source-sync-safety-regression-check.mjs",
    "check:semantic-planner": "tsx tests/semantic-refresh-planner.test.ts && tsx tests/semantic-refresh-pipeline-contract.test.ts && tsx tests/semantic-publication-ordering.test.ts && node scripts/semantic-e2e-fixture-safety-check.mjs",
    "semantic:shadow:once": "tsx scripts/run-semantic-shadow-worker.ts",
    "semantic:e2e:preflight": "node scripts/semantic-e2e-preflight.mjs",
    "semantic:e2e:score-delta": "tsx scripts/semantic-testing-score-delta.ts",
    "check:semantic-storage": "tsx tests/semantic-storage.test.ts && tsx tests/semantic-object-transport.test.ts",
    "check:source-vault": "tsx tests/source-connection-vault.test.ts",
    "check:source-continuity": "tsx tests/source-continuity.test.ts",
    "semantic:reconcile:once": "tsx scripts/reconcile-source-generations.ts",
    "check:source-reconciliation": "tsx tests/source-reconciliation.test.ts",
    "quality:lint": "eslint .",
    "quality:types": "tsc --noEmit && npm run check:frontend:typecheck",
    "quality:unit": "vitest run",
    "quality:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.9.0",
    "csv-parse": "^7.0.2",
    "fastify": "^5.12.5",
    "luxon": "^3.7.2",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.12.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/mssql": "^9.1.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@fastify/busboy": "3.2.1"
  }
}
