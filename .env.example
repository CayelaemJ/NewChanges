# ── Runtime ────────────────────────────────────────────────────────────────
# Set automatically by Railway. Local default is 3000.
# PORT=3000
# NODE_ENV=production

# ── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required in production (startup refuses to run
# without it).
DATABASE_URL=postgresql://user:password@host:5432/database

# First-run admin bootstrap. Used only when the database has no users yet.
# ADMIN_PASSWORD must be 12+ chars with upper, lower and a digit.
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=choose-a-strong-password

# ── Public deployment ──────────────────────────────────────────────────────
# Used for canonical/OG/sitemap links and the cross-origin write check.
PUBLIC_BASE_URL=https://your-production-domain.example
TRUST_PROXY=true
COOKIE_SECURE=true

# ── Contact / legal configuration ──────────────────────────────────────────
# CONTACT_EMAIL is also the contact-form recipient. Without it the contact form
# is disabled and legal pages show a placeholder.
CONTACT_EMAIL=your-real-support-address@example.com
CONTACT_ADDRESS=Deloitte Building, 5 Magwa Crescent, Midrand, 2090, Gauteng, South Africa
PRIVACY_EMAIL=your-real-privacy-address@example.com
LEGAL_EMAIL=your-real-legal-address@example.com
INFORMATION_OFFICER=Named Information Officer

# ── Outbound email (scheduled reports, alerts, contact form) ───────────────
# Configured in Admin > Email settings, or via these variables.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ── Optional tuning ────────────────────────────────────────────────────────
# UPLOAD_MAX_BYTES=52428800
# LOG_LEVEL=info
